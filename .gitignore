# ============================================================
# BinGo – Root .gitignore
# ============================================================

# Dependencies
node_modules/
.npm
.yarn

# Environment variables – NEVER commit these
.env
.env.local
.env.development
.env.production
.env.test

# Build outputs
dist/
build/
out/

# React Native / Expo
mobile/.expo/
mobile/expo-env.d.ts
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/build/
mobile/.metro-cache/

# Android
*.apk
*.aab
*.keystore
!debug.keystore
*.jks

# iOS
*.ipa
*.xcworkspace
*.xcuserdata
*.xccheckout
*.moved-aside

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Coverage
coverage/
.nyc_output/
*.lcov

# IDE & OS files
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# TypeScript
*.tsbuildinfo

# Temporary files
tmp/
temp/
*.tmp
*.temp
