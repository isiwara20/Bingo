{
  "name": "bingo-mobile",
  "version": "1.0.0",
  "description": "BinGo – Neighbourhood Waste & Recycling Coordinator (React Native)",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --mode=release",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest --passWithNoTests",
    "test:keys": "node test-gemini-keys.js",
    "lint": "eslint src/**/*.{js,jsx}",
    "build:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "build:clean": "cd android && ./gradlew clean && cd ..",
    "install:apk": "adb install android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.2",
    "@react-native-community/push-notification-ios": "^1.12.0",
    "@react-navigation/bottom-tabs": "6.5.20",
    "@react-navigation/native": "6.1.17",
    "@react-navigation/native-stack": "6.9.26",
    "axios": "1.7.2",
    "expo-av": "^16.0.8",
    "react": "18.2.0",
    "react-native": "0.74.3",
    "react-native-geolocation-service": "5.3.1",
    "react-native-gesture-handler": "2.17.1",
    "react-native-image-picker": "7.1.2",
    "react-native-maps": "1.14.0",
    "react-native-permissions": "4.1.5",
    "react-native-push-notification": "^8.1.1",
    "react-native-reanimated": "^3.16.7",
    "react-native-safe-area-context": "4.10.6",
    "react-native-screens": "3.32.0",
    "react-native-vector-icons": "10.1.0",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.24.7",
    "@babel/preset-env": "7.24.7",
    "@babel/runtime": "7.24.7",
    "@react-native/babel-preset": "0.74.83",
    "@react-native/eslint-config": "0.74.83",
    "@react-native/metro-config": "0.74.83",
    "babel-jest": "29.7.0",
    "dotenv": "^18.0.7",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "metro-react-native-babel-preset": "0.77.0",
    "react-native-dotenv": "^5.0.0",
    "react-test-renderer": "18.2.0"
  }
}
