# ============================================================
# BinGo Mobile – Environment Variables
# Copy this file to .env and set your real values.
# NEVER commit .env to Git.
# ============================================================

# Backend API Base URL (Production - Render)
API_BASE_URL=https://bingo-backend-2zmk.onrender.com/api/v1

# Gemini AI API Keys (Get from https://aistudio.google.com/app/apikey)
# Keys should start with "AIza" and be ~39 characters long
# You can have multiple keys for rate limit fallback
GEMINI_API_KEY=YOUR_ACTUAL_GEMINI_API_KEY_HERE
GEMINI_API_KEY_2=YOUR_SECOND_GEMINI_API_KEY_HERE
GEMINI_API_KEY_3=YOUR_THIRD_GEMINI_API_KEY_HERE

# ============================================================
# Local Development URLs (uncomment when testing locally)
# ============================================================

# Android Emulator: Use 10.0.2.2 (maps to host machine's localhost)
# API_BASE_URL=http://10.0.2.2:5000/api/v1
#
# Physical Android Device: Use your machine's local network IP
# API_BASE_URL=http://192.168.1.100:5000/api/v1
