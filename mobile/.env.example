# ============================================================
# BinGo Mobile – Environment Variables
# Copy this file to .env and set your backend URL.
# NEVER commit .env to Git.
# ============================================================

# Backend API Base URL
#
# Android Emulator: Use 10.0.2.2 (maps to host machine's localhost)
API_BASE_URL=http://10.0.2.2:5000/api/v1
#
# Physical Android Device: Use your machine's local network IP
# API_BASE_URL=http://192.168.1.100:5000/api/v1
#
# Web / Localhost:
# API_BASE_URL=http://localhost:5000/api/v1
