<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config.
  Allows cleartext HTTP to localhost and the Android emulator host (10.0.2.2)
  so the app can reach the local Express backend during development.
  This file is NOT included in release builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
